# Copy to .env locally; production secrets belong in the hosting secret manager.
DATABASE_URL=
APP_URL=
GEMINI_API_KEY=
# Select an available paid/free-tier model in your Google project; no fixed quota is assumed.
GEMINI_MODEL=
B2B_API_KEY=
CRON_SECRET=
# 32 random bytes encoded as 64 hex characters. Rotation invalidates queued links unless re-encrypted.
TOKEN_ENCRYPTION_KEY=
BUSINESS_POSTAL_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_PER_MINUTE=5
DKIM_SELECTOR=
DKIM_PRIVATE_KEY_PATH=
MAIL_EVENT_SECRET=
ASSIGNMENT_TERMS_PATH=
# JSON file with verified portal form selectors and field mappings; see docs/INGESTION.md.
PORTAL_CONFIG_PATH=
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Optional operator-approved municipal contact directory returning documented JSON.
LICENSE_DIRECTORY_URL=
# Supply either an evidence adapter URL or the ArcGIS query configuration below.
PROPERTY_EVIDENCE_URL=
PROPERTY_EVIDENCE_API_KEY=
APPRAISER_QUERY_URL=
APPRAISER_ADDRESS_FIELD=
APPRAISER_YEAR_FIELD=
APPRAISER_PARCEL_FIELD=
APPRAISER_DATA_DESCRIPTION=
SOIL_QUERY_URL=
SOIL_SALINITY_FIELD=
SOIL_COAST_DISTANCE_FIELD=
SOIL_DATA_DESCRIPTION=
# Blockchain deployment only. Never use the deployer's key as the administrative account.
RPC_URL=
DEPLOYER_PRIVATE_KEY=
USDC_ADDRESS=
MULTISIG_ADMIN=
